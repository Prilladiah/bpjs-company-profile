// ============================================================
// BPJS Ketenagakerjaan Kantor Cabang Yogyakarta - Company Profile
// Database schema (Prisma / PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// AUTH
// ------------------------------------------------------------

/// Admin / operator accounts that can log in to the /admin panel
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

// ------------------------------------------------------------
// BERITA & KEGIATAN  (Home page news cards / "Kelola Berita")
// ------------------------------------------------------------

model Berita {
  id          String   @id @default(cuid())
  keterangan  String // headline / description shown on the card
  tanggal     DateTime // e.g. "18 Agustus 2026"
  link        String? // external / source link ("Selengkapnya")
  foto        String? // image url/path
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("berita")
  @@index([tanggal])
}

// ------------------------------------------------------------
// GALERI  (grouped by category: Kinerja Utama, Capaian, Aktivitas)
// ------------------------------------------------------------

model Galeri {
  id         String        @id @default(cuid())
  keterangan String
  kategori   GaleriKategori
  foto       String
  urutan     Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("galeri")
  @@index([kategori])
}

enum GaleriKategori {
  KINERJA_UTAMA
  CAPAIAN
  AKTIVITAS
}

// ------------------------------------------------------------
// KERJASAMA  (partnership logos/photos shown on Home + admin CRUD)
// ------------------------------------------------------------

model Kerjasama {
  id        String            @id @default(cuid())
  kategori  KerjasamaKategori @unique   // 1 baris tetap per kategori (5 total)
  judul     String                       // judul kartu, mis. "PEMERINTAH DAERAH"
  foto      String?
  poinAwal  String[]                     // bullet di samping foto
  poinAkhir String[]                     // baris teks di bawah kartu (tanpa bullet)
  urutan    Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("kerjasama")
}

enum KerjasamaKategori {
  PEMERINTAH_DAERAH
  DUNIA_USAHA
  PERGURUAN_TINGGI
  KOMUNITAS_PEKERJA
  MEDIA_DAN_DIGITAL
}

model KerjasamaLogo {
  id     String  @id @default(cuid())
  nama   String
  logo   String
  link   String?
  urutan Int     @default(0)

  @@map("kerjasama_logo")
}

model KerjasamaTestimoni {
  id      String  @id @default(cuid())
  isi     String
  nama    String?
  jabatan String?
  urutan  Int     @default(0)

  @@map("kerjasama_testimoni")
}

// ------------------------------------------------------------
// STRUKTUR ORGANISASI  (single uploaded image/PDF, replaces old tree)
// ------------------------------------------------------------

model StrukturOrganisasiFile {
  id        String   @id @default("struktur") // singleton row
  fileUrl   String
  fileType  String   @default("image") // "image" | "pdf"
  updatedAt DateTime @updatedAt

  @@map("struktur_organisasi_file")
}

// ------------------------------------------------------------
// LAYANAN / JAMINAN  (JKK, JKM, JHT, JP, JKP + "Layanan BPJS")
// Powers both /layanan and /cara-klaim pages
// ------------------------------------------------------------

model Layanan {
  id          String         @id @default(cuid())
  kode        String         @unique // e.g. "JHT", "JKK", "JKM", "JP", "JKP"
  nama        String // "Jaminan Hari Tua (JHT)"
  deskripsi   String // paragraph shown as intro on /cara-klaim detail
  icon        String? // icon name or image path
  kategori    LayananKategori
  urutan      Int            @default(0)
  isActive    Boolean        @default(true)

  kriteriaJudul  String  @default("Kriteria Pengajuan Klaim")
  kriteriaKonten String? @db.Text
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("layanan")
  @@index([kategori])
}

enum LayananKategori {
  PROGRAM_UTAMA        // JKK, JKM, JHT, JP, JKP shown on /layanan "Program Utama"
  PROGRAM_UNGGULAN     // numbered highlight cards at top of /layanan
  LAYANAN_TAMBAHAN     // JMO, Lapak Asik, Kantor Cabang, Call Center
}

/// Generic step-by-step "Cara Klaim" flow (Persyaratan Klaim -> ... -> Konfirmasi)
model LangkahKlaim {
  id     String @id @default(cuid())
  judul  String
  icon   String?
  urutan Int    @default(0)

  @@map("langkah_klaim")
}

// ------------------------------------------------------------
// PROFIL PERUSAHAAN (Tentang Kami: Sejarah, Timeline, Visi & Misi)
// ------------------------------------------------------------

model Sejarah {
  id     String @id @default(cuid())
  isi    String // paragraph text
  foto   String?

  @@map("sejarah")
}

model TimelineItem {
  id        String   @id @default(cuid())
  tanggal   String // "5 Desember 1977"
  judul     String // "Perum ASTEK (Asuransi Sosial Tenaga Kerja)"
  urutan    Int      @default(0)

  @@map("timeline_item")
}

model VisiMisi {
  id    String   @id @default(cuid())
  visi  String
  misi  String[] // list of mission points
  @@map("visi_misi")
}

// ------------------------------------------------------------
// PENGATURAN SITUS  (footer: Alamat, Contact, Email, Jam Kerja)
// ------------------------------------------------------------

model SiteSettings {
  id            String @id @default("settings") // singleton row
  alamat        String
  kontak        String
  email         String
  jamKerja      String
  namaKantor    String @default("BPJS Ketenagakerjaan Kantor Cabang Yogyakarta")
  logoUrl       String?

  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}